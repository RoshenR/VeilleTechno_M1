{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a && . <(tr -d '\r' < .env.local) && set +a && npx next start -p 3200"
      ],
      "port": 3200
    },
    {
      "name": "baseline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../ss-before",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}