# ── Supabase ──────────────────────────────────────────────
# Local : valeurs affichées par `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
# Hébergé : Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service role) : serveur uniquement — collecte, catalogue public. Ne jamais l’exposer au navigateur.
SUPABASE_SECRET_KEY=

# URL publique de l’application (liens des e-mails de confirmation / réinitialisation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Planification ─────────────────────────────────────────
# Secret partagé avec le scheduler : GET /api/cron/ingest avec `Authorization: Bearer $CRON_SECRET`.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ── GitHub (recommandé) ───────────────────────────────────
# Secret de déploiement, côté serveur uniquement (jamais de préfixe NEXT_PUBLIC_, jamais dans les logs).
# À ne pas confondre avec le GITHUB_TOKEN éphémère fourni automatiquement aux workflows GitHub Actions.
# Fine-grained token, « Public repositories (read-only) », AUCUNE permission de dépôt ni de compte :
# suffit pour /repos/{owner}/{repo}/releases et /advisories. Sans jeton : 60 requêtes/heure par IP.
# Vérification sans consommer le quota : npm run github:check
GITHUB_TOKEN=

# ── Enrichissement IA (facultatif) ────────────────────────
# Sans clé, tout fonctionne avec les explications issues des règles.
# AI_PROVIDER=anthropic | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_BASE_URL=https://api.openai.com/v1   # pour openai-compatible uniquement
AI_DAILY_BUDGET_PER_USER=20

# ── Exploitation (facultatif) ─────────────────────────────
# Alerte après 3 collectes consécutives en échec ou incomplètes, au plus une fois toutes les 12 h.
# Webhook entrant compatible { "text": … } (Slack, Mattermost, Teams…) ou { "content": … } (Discord).
OPS_ALERT_WEBHOOK_URL=
# Surveillance indépendante (dead man's switch) : URL pinguée après chaque collecte réussie
# (ex. healthchecks.io, Better Stack). Le service externe alerte si les pings s'arrêtent.
OPS_HEARTBEAT_URL=
